# ============================================================
# LinkHub 环境变量模板（复制为 .env 后按实际账号填写）
#
# 核心：换账号只改本文件，不改代码。
#  - 未配置凭据的平台会自动走本地 Mock，并在 API/UI 标注「模拟发送」；
#  - 填完建议先跑 `pnpm run doctor` 自检（凭据/网络/出口 IP/修复建议）。
# ⚠️ 所有平台 *SECRET / *KEY / *APP_SECRET 都是【服务端私有】凭据，
#    绝不以前缀 VITE_ 注入前端，前端拿不到任何真实平台密钥。
#    例外：VITE_API_TOKEN 是演示用的「入口 Bearer 令牌」，本身会进前端 bundle
#    （见 docs/deploy.md 第 3 节与 README 已知限制），正式系统应改为登录态短期凭证。
# ============================================================

# ---- 服务 ----
SERVER_PORT=3001
# 监听地址：留空 = 所有网卡（局域网/容器可访问）；只想本机访问可设 127.0.0.1
# SERVER_HOST=
# 入口鉴权令牌（默认 dev-token，换环境务必修改；留空会回退 dev-token 并告警，仍强制鉴权）
API_TOKEN=dev-token
# CORS 白名单（逗号分隔 Origin）。留空 = 放行所有来源（兼容本地演示）；
# 前端单独部署/对外暴露时建议填，例如：CORS_ORIGINS=http://127.0.0.1:5173
# CORS_ORIGINS=

# ---- 存储（留空=纯内存，无需 Docker 即可本地验证）----
# 部署评审环境时填写，例如：postgres://u:p@postgres:5432/unimsg
DATABASE_URL=
REDIS_URL=
# 闭环数据快照：填了就把消息 / trace / DLQ 落盘，重启后「全链路回放」不丢。
# 本地留空；Docker Compose 会自动设 DATA_DIR=/app/data。
# DATA_DIR=
# DATA_FILE=

# ---- 出站附件 ----
# JSON 请求体上限（MB）。base64 约为原文件 4/3，默认 32MB 覆盖 20MB 总附件。
MAX_UPLOAD_MB=32

# ---- 同源部署（Docker）----
# 指向前端构建产物目录；填了就由 server 直接托管页面，单端口跑完整闭环。
# WEB_DIST=
# VITE_API_BASE=/          # 构建期注入：同源部署必须填 /
# VITE_API_TOKEN=          # 构建期注入：必须与运行期 API_TOKEN 一致
# LINKHUB_DEPLOY_TOKEN=    # compose 专用：生成强随机值后 up -d --build，详见 docs/deploy.md
# HOST_PORT=3001           # compose 宿主机端口映射

# ============================================================
# 运行模式（可替换性核心）
#   auto = 默认：凭据够就走真实接口，不够走本地 Mock
#   real = 强制真实接口（凭据不全时发送会显式报错，绝不静默假成功）
#   mock = 强制本地模拟（即使填了凭据也不外呼，适合离线演示）
# 旧变量 MOCK 已废弃：只在没写 *_MODE 时作为默认策略，并在启动日志警告。
# ============================================================
FEISHU_MODE=auto
DINGTALK_MODE=auto
MAIL_MODE=auto
# 微信个人版：推荐在网站「平台应用配置 → 微信」里切 real/mock；
# 如果在这里显式写，网站的模式选择会被 .env 锁定（不可覆盖）。
# WECHAT_MODE=real
# 纯本地演示（零账号、不连任何外网）时，取消下面五行注释即可：
# FEISHU_MODE=mock
# DINGTALK_MODE=mock
# MAIL_MODE=mock
# WECHAT_MODE=mock

# ---- 边界降级参数 ----
OCR_CONFIDENCE_THRESHOLD=0.7
SEND_MAX_RETRY=3
RETRY_BASE_MS=1000
# 大模型单次调用超时。实测 MiMo flash 单次 2.9–9.3s，8s 会把长尾全部打成降级，故默认 15s
LLM_TIMEOUT_MS=15000
# 平台 HTTP 调用超时（与 LLM 解耦：LLM 长尾不能传染给钉钉/飞书/微信接口）
PLATFORM_TIMEOUT_MS=8000

# ---- 大模型（意图识别 / 摘要 / 回复草稿）----
# provider 填的是「协议类型」而不是厂商中文名：
#   mock   = 内置关键词规则，零密钥可演示
#   openai = OpenAI 兼容协议（火山方舟 / DeepSeek / 通义千问 / 智谱 / MiMo 全部填这个值）
#   GUI 里填「火山引擎 / deepseek / 通义」等厂商名也能自动归一到 openai；厂商靠下面的端点区分。
# 未填 Key 或 provider=mock 时自动走规则识别；真实调用失败一律回退规则并写闭环日志。
LLM_PROVIDER=mock
LLM_API_KEY=
# LLM_MODEL 必须是服务商控制台里的「模型 ID」，不是页面上的显示名
# （例：火山方舟 doubao-seed-1-6-250615；填 Doubao-Seed-2.1-lite 会 404）。
# 且该模型必须在控制台「开通管理」里已激活，否则同样 404。
LLM_MODEL=mimo-v2.6-flash
# 默认小米 MiMo（OpenAI 兼容端点）；换成其它厂商时改这里与 LLM_MODEL 即可。
# LLM_BASE_URL 是 GUI / 旧版 .env 的兼容别名，两个键都读，LLM_ENDPOINT 优先。
LLM_ENDPOINT=https://api.xiaomimimo.com/v1
# 真实模型长尾约 9.3s，8s 会把正常请求打成超时降级；建议 15000 起
LLM_TIMEOUT_MS=15000
# 精度分档线（0–1）：低于它仍采用模型结果，只标低精度、草稿更短，不再回退规则；
# 只有真实调用失败（超时 / 404 / 网络 / 响应不合法）才回退关键词规则
LLM_MIN_CONFIDENCE=0.6
# 改完配置必须重启后端（config 只在启动时解析）；历史消息不会重算，
# 可在消息详情页点「重新生成」用当前配置重新分析，或发一条新消息验证。

# ---- OCR（图片/文件文字提取，真实调用尚未实现，保持 mock 即可）----
# provider: mock(默认) | tencent(腾讯云)
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_SECRET_ID=

# ---- 飞书（自建应用；开发者后台 → 凭证与基础信息 / 事件与回调 → 加密策略）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=
# 长连接（WebSocket）收消息：true 时免公网回调，本机即可收（需在飞书后台「事件配置→订阅方式」
# 选「使用长连接接收事件」并保存，且应用已发布启用）。false = 走 HTTP 回调（需公网 /webhook/feishu）。
FEISHU_STREAM=false

# ============================================================
# 身份能力：本人账号 收 + 发（推荐，免把机器人拉进每个群）
#   机器人身份保留为兼容/兜底，任何状态下 API/UI 都会如实标注「本人 / 机器人 / 模拟」。
#   详细步骤（含平台后台要点）见 docs/personal-identity.md。
# ============================================================
#
# ---- 飞书：本人身份（user_access_token）----
# 身份策略：
#   auto（默认）：已连接本人身份就用本人，否则机器人
#   bot ：固定机器人（即使已授权本人身份）
#   user：固定本人；未授权 / 失效时发送显式报错，绝不悄悄回退机器人
FEISHU_IDENTITY=auto
# 旧变量 FEISHU_SEND_AS 仍可用（兼容旧配置）：仅在未写 FEISHU_IDENTITY 时生效并打印废弃提示
# FEISHU_SEND_AS=auto
#
# 本人身份【接收】：官方没有"个人消息推送事件"，本项目用用户 token 轮询用户所在会话的增量消息。
#   auto（默认）：身份解析为本人时自动开启；true / false 强制开关
#   注意：只有本人可见的会话才读得到；轮询天然有 5–30s 延迟（如实标注，不假装实时）
#   单聊需列会话参数 types=p2p,group 才能看到（未公开参数、官方 CLI 在用；
#   平台若拒绝该参数会自动降级为纯群列表——单聊收不到、群聊继续，不阻断接收）
#   2026-11-12 已用真实租户实测：单聊 + 群聊均以 receivedAs=user 入库
#   （验收记录见仓库根 docs/verification/feishu-personal-e2e-2026-11-12.md）
FEISHU_USER_RECEIVE=auto
# 轮询间隔秒（最小 5，默认 20）
FEISHU_USER_RECEIVE_SECONDS=20
# 每轮最多检查的会话数（默认 20；会话多时按需调大）
FEISHU_USER_CHAT_LIMIT=20
# 首轮回溯小时数：0（默认）= 首轮只立基线不灌历史；24 = 回溯最近 24 小时
FEISHU_USER_BACKFILL_HOURS=0
# 接收水位文件：重启后不漏消息。
# 默认：设了 DATA_DIR → ${DATA_DIR}/feishu-user-receive.json（Docker 即 /app/data/feishu-user-receive.json）
#       未设 DATA_DIR → unimsg-connector/.feishu-user-receive.json（已 gitignore）
# FEISHU_USER_STATE_FILE=
#
# 飞书 OAuth 回调地址：必须与飞书后台「安全设置 → 重定向 URL」完全一致（协议/域名/端口/路径/斜杠都算）
# 后台这一项为空或与这里不一致时，飞书授权页会报 20029（重定向 URL 有误）
# 默认值：http://localhost:<SERVER_PORT>/api/feishu/oauth/callback
# FEISHU_REDIRECT_URI=http://localhost:3001/api/feishu/oauth/callback
# 用户令牌文件（保存 access_token / refresh_token，已 gitignore）
# 默认：设了 DATA_DIR → DATA_DIR/feishu-user-token.json（Docker 为 /app/data，已持久化）
#       未设 DATA_DIR → unimsg-connector/.feishu-user-token.json
# 单实例设计：不要让多个后端进程共享同一个令牌文件（refresh_token 单次有效）
# FEISHU_USER_TOKEN_FILE=
# OAuth 服务域名（国际版 Lark 可改成 https://accounts.larksuite.com）
# FEISHU_ACCOUNTS_BASE_URL=https://accounts.feishu.cn
#
# 飞书后台一次性配置（缺一不可；2026-11-12 真实租户端到端实测有效）：
#   1) 权限管理 → 用户身份权限（共 7 项，含离线访问字段权限）：
#      im:message、im:message.send_as_user、im:resource、
#      im:message.p2p_msg:get_as_user、im:message.group_msg:get_as_user、
#      im:chat:read（缺它列会话报 99991679，单聊 / 群聊都列不出来）、
#      offline_access（后台显示为「持续访问已授权的数据」；缺它授权页报 20027）
#   2) 安全设置 → 重定向 URL：填上面 FEISHU_REDIRECT_URI 的值（为空 / 不一致时授权页报 20029）
#   3) 持续授权：在用户身份权限里开通 offline_access（「持续访问已授权的数据」）；
#      开通并重新授权后 OAuth 返回 refresh_token + refresh_token_expires_in 即自动续期
#      （新版控制台没有「刷新 user_access_token」独立开关，安全设置只有「重定向 URL」「IP 白名单」）
#   4) 正式应用需发布版本并使权限生效（测试应用改动免审即时生效）；当前飞书账号需在应用可用范围内
#   5) 启动后在 LinkHub「平台账号」页点飞书卡片的「连接本人账号」完成授权
#      （已连接后按钮变为「重新授权」）；从旧版本升级后必须重新授权一次
#      （旧令牌不含 im:chat:read 等新增 scope）
# offline_access 既是 OAuth scope，也要在「用户身份权限」里开通，两步都不能省；
# 令牌只存服务端，绝不下发前端。

# ---- 钉钉：本人身份（官方开源 CLI dws，子进程调用）----
# 前置条件（平台侧现实限制，必须满足）：
#   1) 安装钉钉官方 CLI：https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli
#      （本机已装则 DWS_BIN 保持默认 dws）
#   2) 企业管理员在钉钉开发者后台开启「CLI 访问管理」；或走自有应用 Custom App 模式：
#      dws auth login --client-id <AppKey> --client-secret <AppSecret>
#   3) 用户首次 dws auth login（浏览器 / --device device flow）授权，token 存本机 ~/.dws
# 身份策略：auto（默认，已登录就用本人，否则机器人）| bot（固定机器人）| user（固定本人，未登录显式报错）
DINGTALK_IDENTITY=auto
# 本人身份【接收】：auto（默认）= 身份解析为本人时自动开启；true / false 强制开关
DINGTALK_USER_RECEIVE=auto
# 个人事件订阅范围（逗号分隔，可多选）：
#   all-direct = 全部单聊（默认）  at-me = @我（默认）  all-group = 全部群消息
#   注意：group（指定群）/ sender（指定发送人）需要 dws 的群/人目标参数，LinkHub 暂不支持，
#   配了会被忽略并在启动日志告警（避免子进程反复失败重启）。
#   加 all-group 只会额外保留「你自己在群里发的消息（含文件）」，群里别人的普通消息仍按 at-me 处理，
#   不会把整个群灌进收件箱、也不逐条跑大模型。
DINGTALK_USER_EVENT_KINDS=all-direct,at-me,all-group
# dws 可执行文件（默认 dws，在 PATH 里）；可带参数，如 node scripts/fake-dws.mjs（离线演示/测试用）
DWS_BIN=dws
# 指定 dws 登录档案（多账号时用；一般留空）
DWS_PROFILE=
# dws 命令超时（毫秒）：auth/status 类 1000–120000（默认 15000）；发送类 1000–600000（默认 30000）
DWS_AUTH_TIMEOUT_MS=15000
DWS_SEND_TIMEOUT_MS=30000

# 国际版 Lark / 代理网关可覆盖（一般不用改）
# FEISHU_BASE_URL=https://open.feishu.cn

# ---- 钉钉（企业内部应用；开发者后台 → 凭证与基础信息 / 应用能力 → 机器人）----
# 新版后台叫 Client ID / Client Secret；旧版叫 AppKey / AppSecret（两种都支持）
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 机器人编码，企业内部应用通常与 Client ID 相同（留空自动取 Client ID）
DINGTALK_ROBOT_CODE=
# HTTP 回调模式才需要（事件订阅的 Token / 加密密钥）
DINGTALK_AES_TOKEN=
DINGTALK_AES_KEY=
# Stream 长连接：true 时本机无需公网回调即可收机器人消息
# 需在「应用能力 → 机器人」把消息接收模式选为 Stream 并发布版本
# 只用本人身份时保持 false：关掉机器人 Stream 可避免与 dws 个人事件流重复入库，
# 并配合上面的 DINGTALK_IDENTITY=user（DINGTALK_MODE 保持 auto，不要设 mock）
DINGTALK_STREAM=false
# DINGTALK_BASE_URL=https://api.dingtalk.com

# ============================================================
# 微信个人版（RPA 通道，无官方收发 API）
#  1) 后端只认本地 RPA 桥地址；桥是独立 Python 进程：scripts/wechat-rpa/rpa_bridge.py
#  2) WECHAT_MODE=mock 零依赖自测；real 需先在 Windows 登录微信桌面端并装 pyautogui/pyperclip/pywin32
#     （3.9.x 自动接收还要 uiautomation；4.x 的「按需拉取」只要 pyautogui 三个包）
#     ⚠ 微信 4.x（Weixin.exe，Qt 自绘）不暴露可访问性控件树：自动轮询不可用，
#       接收用「按需拉取」（POST /api/wechat/pull，拖选复制原文）；3.9.x 才能自动轮询
#  3) 3.9.x 的入站由桥用 UI Automation 轮询微信窗口后 POST /api/webhook/wechat（签名 dev-rpa），复用标准入库链路
#     4.x 的入站同样走这个 webhook，只是消息由 /pull 从剪贴板解析而来
#  3.1) 可选：WECHAT_SELF_NAME=你的微信昵称 —— 过滤「自己发的消息」，避免被当成入站
#  4) WECHAT_MODE=real 只表示"允许真实操作"：后端会实测桥的 /health，桥是 mock 时发送会被拒绝，不会写 real
#  5) 明确为补充通道：受窗口布局/分辨率影响、有账号风控风险，不做 7x24 稳定运行
#  6) 推荐在网站「平台应用配置 → 微信」里填地址/切模式；显式写到 .env 会锁定 GUI 覆盖
# ============================================================
# WECHAT_BRIDGE_URL=http://127.0.0.1:8787

# ============================================================
# 邮箱数据源：任意数量、任意服务商（IMAP 收 + SMTP 发，免公网回调）
#  1) 自动发现（推荐）：填 MAIL_<KEY>_ADDRESS / MAIL_<KEY>_AUTH_CODE，
#     KEY 可随意取（qq / 163 / work / school2 …），可配多个账号；
#  2) 也可用 MAIL_ACCOUNTS=qq,163,work 显式声明要启用的账号：
#     写了它就只加载列出的 key，未列出的即使填了 ADDRESS/AUTH_CODE 也不会启用。
# 授权码 ≠ 网页登录密码：需先在网页端开启 IMAP/SMTP 服务并生成授权码。
# 反垃圾可能把回信扔进垃圾箱：用 MAIL_<KEY>_FOLDERS=INBOX,Junk 一起监听。
# ============================================================
MAIL_POLL_SECONDS=45
# 邮箱 UID 水位状态文件（默认 unimsg-connector/.mail-watermarks.json，重启后不漏信）
# 一般不用改；如需放到数据盘可填绝对路径
# MAIL_STATE_FILE=
# 兼容旧变量：不填 = 有账号就开启轮询；false = 只发不收
# MAIL_ENABLED=true

# 账号一：QQ 邮箱（内置预设 imap.qq.com:993 / smtp.qq.com:465）
# QQ：设置 → 账号与安全 → 安全设置 → POP3/IMAP/SMTP 服务 → 开启并生成授权码
MAIL_QQ_ADDRESS=
MAIL_QQ_AUTH_CODE=
MAIL_QQ_FOLDERS=INBOX

# 账号二：网易 163（内置预设 imap.163.com:993 / smtp.163.com:465）
# 163：设置 → POP3/SMTP/IMAP → 开启服务 → 新增授权密码（只显示一次）
MAIL_163_ADDRESS=
MAIL_163_AUTH_CODE=
MAIL_163_FOLDERS=INBOX

# 账号三示例：任意服务商（126 / yeah / gmail / outlook / icloud 有内置预设，其他用 custom）
# MAIL_WORK_ADDRESS=me@company.com
# MAIL_WORK_AUTH_CODE=授权码
# MAIL_WORK_PROVIDER=custom            # qq | 163 | 126 | yeah | gmail | outlook | icloud | custom
# MAIL_WORK_LABEL=公司邮箱
# MAIL_WORK_IMAP_HOST=imap.company.com
# MAIL_WORK_SMTP_HOST=smtp.company.com
# 端口/加密方式一般不用写；写了会覆盖预设：
#   993 / 465 = 隐式 TLS（默认）；143 / 587 / 25 = STARTTLS
# MAIL_WORK_IMAP_PORT=993
# MAIL_WORK_SMTP_PORT=587
# MAIL_WORK_IMAP_SECURE=true
# MAIL_WORK_SMTP_SECURE=false
# MAIL_WORK_FOLDERS=INBOX,Junk

# ---------------------------------------------------------------------------
# 账号体系（登录/注册）
# ---------------------------------------------------------------------------
# 是否强制登录：auto（默认：本机有账号就必须登录）| true | false
# AUTH_REQUIRE_LOGIN=auto
# 注册准入：auto（默认：首个账号可自助注册，之后默认关闭）| open | closed
#   auto + 已配置 AUTH_SIGNUP_CODE 时，凭邀请码仍可添加成员
# AUTH_REGISTRATION=auto
