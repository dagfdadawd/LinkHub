node_modules/
dist/
.env
# 测试 / e2e 的兜底临时目录（%TEMP% 不可写的机器上会落在这里）
.tmp/
# e2e / 运维日志（可随时删除，不进仓库）
*.log
*.log.err
.DS_Store
# 邮箱 UID 水位状态文件（运行期原子写，重启续传用，不进仓库）
.mail-watermarks.json
# 闭环数据快照（DATA_DIR 落盘目录，运行期产物，不进仓库）
.data/
# 飞书用户身份令牌（user_access_token / refresh_token，运行期授权产物）
.feishu-user-token.json
# 飞书本人身份接收水位（按会话记录最后一条消息时间，运行期原子写，不进仓库）
.feishu-user-receive.json
*.tmp

# 视觉走查截图（本地临时产物）
.shots/
# 运行期数据快照（DATA_DIR 指向这里时产生，不进仓库）
data/

# 内置工具（pnpm run fetch:dws 下载的 dws 可执行文件，约 25MB，不进仓库）
tools/
# 本地导入的邮箱账号（含授权码！personal 版「连接账号」页保存，绝不进仓库）
.linkhub-mail-accounts.json
# 本地账号库（注册的账号 + 会话令牌，含口令哈希；无 DATA_DIR 时落在仓库根，绝不进仓库）
.linkhub-users.json
# 同上，含手工改动前的备份副本（.bak/.old/时间戳等），避免口令哈希被误提交
.linkhub-users.json.*
.linkhub-users.*.json# 自动回复规则（DATA_DIR 下的运行期产物；DATA_DIR 未设时纯内存不落盘）
auto-rules.json
# 消息快照（DATA_FILE 默认名，运行期产物）
linkhub-state.json
# 本地应用配置（GUI 填写的平台凭据/模式，含 App Secret，绝不进仓库；有 DATA_DIR 时在 DATA_DIR 下）
.linkhub-config.json
