*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# Workspace agent data (local memory, not project source)
.workbuddy/

# Generated submission artifacts (export PDF only for submission, keep sources in repo)
*.pdf

# Office lock/temp files
~$*
